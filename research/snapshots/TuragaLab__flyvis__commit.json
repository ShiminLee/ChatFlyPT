980d703297822080b7efc3e65","filename":".github/workflows/release.yml","status":"modified","additions":6,"deletions":1,"changes":7,"blob_url":"https://github.com/TuragaLab/flyvis/blob/92b3845cc426dd309a1a0e1b3890156c42e14021/.github%2Fworkflows%2Frelease.yml","raw_url":"https://github.com/TuragaLab/flyvis/raw/92b3845cc426dd309a1a0e1b3890156c42e14021/.github%2Fworkflows%2Frelease.yml","contents_url":"https://api.github.com/repos/TuragaLab/flyvis/contents/.github%2Fworkflows%2Frelease.yml?ref=92b3845cc426dd309a1a0e1b3890156c42e14021","patch":"@@ -91,7 +91,12 @@ jobs:\n           assert len(norms.checkpoint_hashes) == 50, norms\n           print(\"installed package ships constants for\", norms)\n           PY\n-          /tmp/smoke/bin/flyvis --help > /dev/null\n+          # `flyvis --help` prints the help and exits 1, because a bare invocation\n+          # selects no command. Check what it prints rather than its status, which\n+          # also verifies that the command registry survived packaging.\n+          /tmp/smoke/bin/flyvis --help > /tmp/smoke-help.txt 2>&1 || true\n+          grep -q \"responses-norm\" /tmp/smoke-help.txt\n+          echo \"installed console script lists the expected commands\"\n \n       - uses: actions/upload-artifact@v4\n         with:"}]}